# ── Energy Predictor — Environment Configuration ─────────────────────────────
# Copy this file to .env and adjust as needed.
# docker-compose reads .env automatically from the project root.

# Backend settings
DATABASE_URL=sqlite:////app/storage/energy_predictor.db
DATA_DIR=/app/storage/data
RUNS_DIR=/app/storage/runs

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost,http://localhost:80

# Set to false in production
DEBUG=false

# ── Port overrides (optional) ─────────────────────────────────────────────────
# Uncomment to change default ports
# HOST_UI_PORT=80
# HOST_API_PORT=8000
